# Copy this file to .env (same folder) and put a real password.
# .env is ignored by git, so the password never reaches GitHub.
DB_PASSWORD=change-me

# --- Only when there is a load balancer with more than one node (see docs/load-balancer.md) ---
# Primary node (runs the database and shares it):
# COMPOSE_FILE=docker-compose.yml:compose.primary.yml
# NODE_NAME=progweb-1
#
# App node (uses the primary's database):
# COMPOSE_FILE=docker-compose.yml:compose.app-node.yml
# DB_HOST=<private IP of the primary node>
# NODE_NAME=progweb-2
